{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Classic EXP Tracker",
  "version": "0.8.0",
  "identifier": "com.classicexp.tracker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Classic EXP Tracker",
        "width": 1100,
        "height": 760,
        "visible": false,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Kwuasimoto",
    "copyright": "Copyright © 2026 Kwuasimoto. MIT License.",
    "homepage": "https://github.com/Kwuasimoto/classic-exp-tracker",
    "shortDescription": "EXP/hr tracker for MapleStory Classic World",
    "longDescription": "Measures EXP/hr in MapleStory Classic World by reading the primary monitor. It never opens, reads or sends input to the game."
  }
}
