{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Classic EXP Tracker",
  "version": "0.12.0",
  "identifier": "com.classicexp.tracker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Classic EXP Tracker",
        "width": 1100,
        "height": 760,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Kwuasimoto",
    "copyright": "Copyright © 2026 Kwuasimoto. MIT License.",
    "homepage": "https://github.com/Kwuasimoto/classic-exp-tracker",
    "shortDescription": "EXP/hr tracker for MapleStory Classic World",
    "longDescription": "Measures EXP/hr in MapleStory Classic World by reading the primary monitor. It never opens, reads or sends input to the game.",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese",
          "Korean",
          "Japanese",
          "Spanish",
          "PortugueseBR",
          "Thai",
          "Vietnamese"
        ],
        "customLanguageFiles": {
          "Thai": "nsis/Thai.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0RDQ4MThFOUIzNEM4RjYKUldUMnlEU2Jqb0hVTk9BREpQZUpGUkRNSnN0MkxFajhjSEdCazdqcWZEQ1FYbWhmQXJjV3A1bzkK",
      "endpoints": [
        "https://github.com/Kwuasimoto/classic-exp-tracker/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
