# Dependencies and build output
node_modules/
dist/
src-tauri/target/
src-tauri/target-tools/
src-tauri/gen/schemas/

# App data: the tracker's database and logs live in %APPDATA% and %LOCALAPPDATA%,
# but never commit a copy (it holds the user's play history).
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
# Configs (and older glyph libraries) exported from the Glyphs page: a user's data, like the database
classic-exp-tracker-config*.json
glyphs-*.json

# glyph-collect recordings and meso-watch snapshots (dev tool, see src-tauri/src/bin/glyph_collect.rs)
frames*.txt
debug/

# Local environment and editor files
*.local
.env*
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
